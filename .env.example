# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must NEVER be committed.
# The same variables must also be added to your Vercel project's
# Environment Variables settings (https://vercel.com/docs/environment-variables).

# ── Client-side (exposed to the browser) ────────────────────────────────────
# The Client ID from your GitHub OAuth App settings.
# Safe to be public — it identifies the app but grants no access on its own.
VITE_GITHUB_CLIENT_ID=your_github_oauth_app_client_id_here

# The GitHub owner (org or user) and repo name for the Issues data layer.
# Safe to be public — this is the team's public project repository.
VITE_GITHUB_OWNER=Sven-Lutz
VITE_GITHUB_REPO=Taskboard

# ── Server-side (Vercel serverless function only) ────────────────────────────
# The Client Secret from your GitHub OAuth App settings.
# MUST stay server-side only. Add this to Vercel env vars; do NOT put it here.
# GITHUB_CLIENT_SECRET=  ← set this in Vercel dashboard only
